# Host ports for docker compose. Change these if another project already publishes
# 5432 or 6379, and keep backend/.env in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Host gcloud config, mounted read-only into the worker so it can reach
# Vertex with your Application Default Credentials.
# Windows: C:/Users/<you>/AppData/Roaming/gcloud
# macOS/Linux: ~/.config/gcloud
GCLOUD_CONFIG_DIR=~/.config/gcloud

# Celery worker processes. Ingestion waits on Vertex, so this can exceed cores.
WORKER_CONCURRENCY=4
