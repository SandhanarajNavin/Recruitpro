# ── node / next ───────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.vercel/

# ── python ────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── env ───────────────────────────────────────
.env
.env.local
.env.*.local

# ── local resume storage (never commit candidate files) ──
backend/uploads/*
!backend/uploads/.gitkeep
# Root-anchored on purpose. Unanchored, "storage/" matched backend/app/storage/ and
# silently kept the whole storage package out of the repo — a clone could not import
# app.storage at all, and gcloud builds submit inherits .gitignore when there is no
# .gcloudignore, so the same pattern would have shipped an image without it.
/storage/

# ── editors / os ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
