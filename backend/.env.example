# ── database / queue ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitment
DB_CONNECT_TIMEOUT=5
REDIS_URL=redis://localhost:6379/0

# Run background tasks inline instead of on a Celery worker. Set true to run the
# whole system with no Redis and no worker process.
#
# False is safe without a worker too: dispatch pings for one and falls back to
# inline when none answers, so uploads never strand at "queued". Leave it false and
# start a worker with `docker compose up -d worker` when you want bulk uploads to
# return immediately rather than block for ~6s per file.
TASK_ALWAYS_EAGER=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API. Defaults cover
# localhost/127.0.0.1 on ports 3000 and 3001. A browser treats "localhost" and
# "127.0.0.1" as different origins, and Next.js moves to 3001 when 3000 is busy —
# an origin missing here shows up as a 400 on the OPTIONS preflight.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# Set false to require accounts to be provisioned rather than self-registered.
ALLOW_SELF_SIGNUP=true

# ── AI layer — Gemini on Vertex AI (architecture doc §16, §29) ────────────
# Leave GOOGLE_CLOUD_PROJECT unset to run the deterministic engine. Parsing,
# retrieval, scoring and explanations all still work — the mode is reported on
# /health and on the dashboard.
#
# Vertex (bills to the GCP project, what the design document specifies):
GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
#   Credentials come from Application Default Credentials:
#     gcloud auth application-default login
#   In Cloud Run, the service account provides them automatically.
#
# Or the Gemini Developer API instead (set GOOGLE_GENAI_USE_VERTEXAI=false):
# GOOGLE_API_KEY=

RECRUITER_MODEL=gemini-2.5-pro
# Mechanical extraction runs on the cheaper model (§25).
EXTRACTION_MODEL=gemini-2.5-flash
# Thinking budget in tokens; -1 lets the model decide, 0 disables.
RECRUITER_THINKING_BUDGET=-1
EXTRACTION_THINKING_BUDGET=0

# offline | openai. The offline hashing embedder needs no account and is
# dimension-compatible with 1536-dimension hosted models. A Vertex embedder is not
# implemented yet, so embeddings stay local even when Gemini is configured.
EMBEDDING_PROVIDER=offline
EMBEDDING_MODEL=offline-hashing-v1
EMBEDDING_DIM=1536

# auto | gemini | lexical
RERANKER_PROVIDER=auto

# ── storage ───────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads
# S3_BUCKET=
# S3_REGION=

# ── funnel widths (architecture doc §10) ──────────────────────────────────
RETRIEVAL_LIMIT=100
RERANK_LIMIT=20
SHORTLIST_SIZE=5

# ── scoring weights (§11) — must sum to 1.0 ───────────────────────────────
WEIGHT_REQUIRED_SKILLS=0.40
WEIGHT_EXPERIENCE=0.25
WEIGHT_RESPONSIBILITIES=0.20
WEIGHT_EDUCATION_CERTIFICATIONS=0.10
WEIGHT_SEMANTIC_SIMILARITY=0.05

# ── local dev server (only read by `python -m app.main`) ──────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
